---
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/' && (pathname === '/' || pathname === '')) return true;
  if (path !== '/' && pathname.startsWith(path)) return true;
  return false;
};

const navLinks = [
  { href: '/', label: 'Inicio', shortLabel: 'Inicio' },
  { href: '/nosotros', label: 'Nosotros & ISO 9001', shortLabel: 'Nosotros' },
  { href: '/maquinaria', label: 'Maquinaria & Minería', shortLabel: 'Maquinaria' },
  { href: '/epp', label: 'EPP e Indumentaria', shortLabel: 'EPP' },
  { href: '/suministros', label: 'Ferretería & Suministros', shortLabel: 'Suministros' },
  { href: '/contacto', label: 'Contacto', shortLabel: 'Contacto' },
];
---

<header class="sticky top-0 z-50 w-full bg-[#060B14] text-slate-200 border-b border-slate-800 shadow-xl transition-colors duration-300 select-none">
  <!-- Top Utility Bar (Docked) -->
  <div class="hidden md:block bg-[#02050B] text-slate-400 text-[11px] font-semibold border-b border-slate-800/80 py-1.5 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <!-- Left: ISO Stamp & Operational Status -->
      <div class="flex items-center gap-4 sm:gap-6">
        <div class="flex items-center gap-2 text-amber-400">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span class="font-bold tracking-wider whitespace-nowrap">SGC ISO 9001:2015 CERTIFICADO</span>
        </div>
        <span class="text-slate-700">|</span>
        <span class="text-slate-400 font-medium truncate">Servicios Totales del Perú S.A.C. • Entrega en Obra a Nivel Nacional</span>
      </div>

      <!-- Right: Direct Phone & Email -->
      <div class="flex items-center gap-4 sm:gap-6 shrink-0">
        <a href="tel:963895085" class="hover:text-white transition flex items-center gap-1.5 whitespace-nowrap">
          <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span class="text-slate-300 hover:text-white">+51 963 895 085</span>
        </a>
        <span class="text-slate-700">|</span>
        <a href="mailto:contacto@servitotales.com" class="hover:text-white transition flex items-center gap-1.5 whitespace-nowrap">
          <svg class="w-3.5 h-3.5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <span class="text-slate-300 hover:text-white">contacto@servitotales.com</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Row -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-2 sm:gap-4">
      <!-- Left: Brand Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0 group">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-br from-blue-600 to-[#07172C] p-2 flex items-center justify-center border border-blue-500/40 shadow-md group-hover:scale-105 transition-transform">
          <svg viewBox="0 0 40 40" class="w-full h-full" fill="none">
            <circle cx="20" cy="20" r="18" stroke="#DC2626" stroke-width="2.5" stroke-dasharray="80 30"></circle>
            <path d="M12 25C12 20 16 18 20 16C24 14 28 14 28 10C28 7 24 6 20 6C16 6 13 8 13 8" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round"></path>
            <path d="M28 15C28 20 24 22 20 24C16 26 12 26 12 30C12 33 16 34 20 34C24 34 27 32 27 32" stroke="#DC2626" stroke-width="3" stroke-linecap="round"></path>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-lg sm:text-2xl font-black tracking-wider text-white font-heading leading-tight">
            SERVI<span class="text-[#DC2626]">TOTALES</span>
          </span>
          <span class="text-[7.5px] sm:text-[9px] tracking-widest uppercase font-bold text-blue-400 whitespace-nowrap">
            Maquinaria • Minería • EPP • Suministros
          </span>
        </div>
      </a>

      <!-- Center: Main Navigation Menu (Centered, Auto-adaptive labels, No Overflows) -->
      <nav class="hidden lg:flex items-center justify-center flex-1 mx-2 xl:mx-6 gap-3 xl:gap-6 text-xs font-bold uppercase tracking-wider text-slate-300">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class={`py-2 px-1.5 relative whitespace-nowrap transition-all duration-200 ${
                active
                  ? 'text-[#DC2626] font-black'
                  : 'hover:text-white'
              }`}
            >
              <!-- Full label on 2xl+, short label on lg/xl to guarantee 0 overflow -->
              <span class="hidden 2xl:inline">{link.label}</span>
              <span class="inline 2xl:hidden">{link.shortLabel}</span>
              {active && (
                <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-[#DC2626] rounded-full"></span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Right Controls: Light/Dark Toggle + Primary CTA -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <ThemeToggle />

        <!-- Primary Quotation CTA -->
        <a
          href="/contacto"
          class="px-4 sm:px-5 py-2 sm:py-2.5 text-xs font-black uppercase tracking-wider text-white bg-[#DC2626] hover:bg-[#B91C1C] rounded-xl shadow-md hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 transition-all whitespace-nowrap"
        >
          Cotizar
        </a>

        <!-- Mobile Menu Toggle (Visible below lg: 1024px) -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="lg:hidden p-2 rounded-xl border border-slate-800 bg-[#0B1528] text-slate-200 hover:border-[#DC2626] transition-colors"
          aria-label="Abrir Menú"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#0A1224] border-b border-slate-800 px-6 py-5 space-y-3 shadow-2xl animate-in fade-in duration-200">
    {navLinks.map((link) => {
      const active = isActive(link.href);
      return (
        <a
          href={link.href}
          class={`block py-2.5 px-3 rounded-xl text-sm font-bold transition-colors ${
            active ? 'text-white bg-[#DC2626]' : 'text-slate-300 hover:bg-[#0F1E3A] hover:text-white'
          }`}
        >
          {link.label}
        </a>
      );
    })}
    <div class="pt-4 border-t border-slate-800 flex flex-col gap-3">
      <div class="flex items-center gap-2 text-xs font-bold text-amber-400 px-3">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span>Certificación SGC ISO 9001:2015</span>
      </div>
      <a
        href="/contacto"
        class="w-full py-3 text-center text-xs font-black uppercase tracking-wider text-white bg-[#DC2626] rounded-xl shadow-md"
      >
        Solicitar Cotización Técnica
      </a>
    </div>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  mobileBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>