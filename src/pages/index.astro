---
import Layout from '../layouts/Layout.astro';

const equipmentLines = [
  {
    name: "Excavadoras sobre Orugas",
    tag: "CAT 320/336",
    href: "https://wa.me/51963895085?text=Hola%20Servitotales%2C%20deseo%20cotizar%3A%20Excavadoras%20sobre%20Orugas"
  },
  {
    name: "Cargadores & Retroexcavadoras",
    tag: "Línea Amarilla",
    href: "https://wa.me/51963895085?text=Hola%20Servitotales%2C%20deseo%20cotizar%3A%20Cargadores%20Frontales"
  },
  {
    name: "Minería Subterránea Trackless",
    tag: "Jumbos / Scoops",
    href: "https://wa.me/51963895085?text=Hola%20Servitotales%2C%20deseo%20cotizar%3A%20Mineria%20Trackless"
  },
  {
    name: "Volquetes & Camiones Grúa",
    tag: "Acarreo Pesado",
    href: "https://wa.me/51963895085?text=Hola%20Servitotales%2C%20deseo%20cotizar%3A%20Volquetes%20y%20Camiones"
  }
];

const marqueeItems = [
  "SGC ISO 9001:2015 CERTIFICADO",
  "ALQUILER DE MAQUINARIA PESADA",
  "OPERADORES Y TÉCNICOS HOMOLOGADOS",
  "ENTREGA DIRECTA EN OBRA A NIVEL NACIONAL",
  "EQUIPOS DE PROTECCIÓN PERSONAL ANSI/OSHA",
  "MANTENIMIENTO TÉCNICO ESPECIALIZADO 24/7"
];
---

<Layout>
  <!-- Hero Section: Clean, Cinematic, High-Impact & Spacious -->
  <section id="inicio" class="relative min-h-[85vh] lg:min-h-[88vh] flex flex-col justify-center pt-12 pb-16 lg:pt-16 lg:pb-24 border-b border-slate-800/80 bg-[#050A14] overflow-hidden text-white">
    <!-- Full-Bleed Atmospheric Background Image -->
    <div class="absolute inset-0 w-full h-full z-0 overflow-hidden pointer-events-none select-none">
      <img
        src="/images/hero-fleet.jpg"
        alt="Flota de maquinaria pesada Servitotales en faena al atardecer"
        loading="eager"
        decoding="async"
        class="w-full h-full object-cover object-right lg:object-center opacity-60 contrast-115 saturate-110"
      />
      <!-- Directional Smooth Gradient Overlays -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#050A14] via-[#050A14]/90 via-45% to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#050A14] via-transparent to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Left Column: Focused, Clean & Direct -->
        <div class="lg:col-span-7 space-y-6">
          <!-- ISO Badge -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-600/15 border border-red-500/30 text-red-400 font-mono text-[11px] font-bold tracking-wider uppercase">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
            <span>SGC ISO 9001:2015 • MINERÍA & CONSTRUCCIÓN</span>
          </div>

          <!-- Main Headline (Punchy & Direct) -->
          <h1 class="text-3xl sm:text-5xl lg:text-[52px] font-black tracking-tight text-white leading-[1.1] font-heading">
            Potenciamos tus Proyectos con <br class="hidden sm:inline" />
            <span class="text-gradient-red">Maquinaria Pesada & EPP</span>
          </h1>

          <!-- Concise Subtitle -->
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-xl font-normal">
            Aliado estratégico para construcción, minería y obras viales a nivel nacional. Flota moderna con operadores homologados, mantenimiento 24/7 y entrega directa en obra.
          </p>

          <!-- Core Benefits (Minimalist horizontal pill list) -->
          <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs text-slate-300 font-semibold pt-1">
            <span class="px-3 py-1.5 rounded-xl bg-slate-900/80 border border-slate-800 backdrop-blur-md flex items-center gap-1.5">
              <span class="text-emerald-400">✓</span> Operadores Homologados
            </span>
            <span class="px-3 py-1.5 rounded-xl bg-slate-900/80 border border-slate-800 backdrop-blur-md flex items-center gap-1.5">
              <span class="text-blue-400">✓</span> Soporte en Sitio 24/7
            </span>
            <span class="px-3 py-1.5 rounded-xl bg-slate-900/80 border border-slate-800 backdrop-blur-md flex items-center gap-1.5">
              <span class="text-amber-400">✓</span> Despacho a Nivel Nacional
            </span>
          </div>

          <!-- Direct CTA Buttons -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-4">
            <a
              href="/contacto"
              class="px-8 py-4 text-xs font-black uppercase tracking-widest text-white bg-[#DC2626] hover:bg-[#B91C1C] rounded-2xl shadow-xl shadow-red-950/50 hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-3 cursor-pointer"
            >
              <span>Solicitar Cotización Inmediata</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
            <a
              href="/maquinaria"
              class="px-7 py-4 text-xs font-black uppercase tracking-widest text-slate-200 hover:text-white bg-slate-900/80 hover:bg-slate-800/90 border border-slate-700/80 rounded-2xl transition-all flex items-center justify-center gap-2 hover:-translate-y-0.5 backdrop-blur-md"
            >
              <span>Ver Catálogo</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Streamlined Quick-Quotation Panel -->
        <div class="lg:col-span-5 flex flex-col">
          <div class="relative rounded-3xl overflow-hidden border border-slate-800 shadow-2xl bg-[#081020]/90 backdrop-blur-xl p-6 sm:p-7 space-y-4">
            <!-- Header -->
            <div class="flex items-center justify-between pb-3 border-b border-slate-800">
              <div>
                <span class="text-[10px] font-mono font-bold tracking-widest uppercase text-amber-400 block">Cotización Directa</span>
                <h3 class="text-base font-black font-heading text-white">Disponibilidad de Flota</h3>
              </div>
              <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-[11px] font-bold">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>En Servicio</span>
              </div>
            </div>

            <!-- Streamlined Selector (4 Core Categories) -->
            <div class="space-y-2">
              {equipmentLines.map((item) => (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between p-3 rounded-xl bg-[#0D182E]/70 hover:bg-[#DC2626] hover:text-white border border-slate-800/90 hover:border-transparent transition-all text-xs font-bold text-slate-200 group shadow-sm"
                >
                  <span class="flex items-center gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#DC2626] group-hover:bg-white transition-colors"></span>
                    <span>{item.name}</span>
                  </span>
                  <div class="flex items-center gap-2">
                    <span class="text-[10px] font-mono text-slate-400 group-hover:text-white/90">{item.tag}</span>
                    <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-white group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </div>
                </a>
              ))}
            </div>

            <!-- Footer Contact Call -->
            <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs">
              <span class="text-slate-400 font-medium">Atención Técnica 24/7</span>
              <a href="tel:963895085" class="text-xs font-bold text-blue-400 hover:text-blue-300 flex items-center gap-1 font-mono">
                <span>+51 963 895 085</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Compact Performance Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 pt-8 border-t border-slate-800/70">
        <div class="p-4 rounded-2xl bg-[#0B1528]/60 border border-slate-800/80 text-center sm:text-left">
          <div class="text-2xl sm:text-3xl font-black text-white font-heading">ISO 9001</div>
          <div class="text-xs text-slate-300 font-semibold mt-0.5">Certificación SGC</div>
        </div>
        <div class="p-4 rounded-2xl bg-[#0B1528]/60 border border-slate-800/80 text-center sm:text-left">
          <div class="text-2xl sm:text-3xl font-black text-white font-heading">100%</div>
          <div class="text-xs text-slate-300 font-semibold mt-0.5">Cobertura Nacional</div>
        </div>
        <div class="p-4 rounded-2xl bg-[#0B1528]/60 border border-slate-800/80 text-center sm:text-left">
          <div class="text-2xl sm:text-3xl font-black text-white font-heading">24/7</div>
          <div class="text-xs text-slate-300 font-semibold mt-0.5">Soporte Mecánico</div>
        </div>
        <div class="p-4 rounded-2xl bg-[#0B1528]/60 border border-slate-800/80 text-center sm:text-left">
          <div class="text-2xl sm:text-3xl font-black text-white font-heading">2030</div>
          <div class="text-xs text-slate-300 font-semibold mt-0.5">Visión de Liderazgo</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Kinetic Marquee Ticker -->
  <section class="py-4 bg-[var(--bg-surface)] border-b border-[var(--border-subtle)] overflow-hidden relative">
    <div class="marquee-track flex items-center gap-12 whitespace-nowrap">
      {[...marqueeItems, ...marqueeItems].map((item) => (
        <div class="flex items-center gap-12 flex-shrink-0">
          <span class="text-xs font-black tracking-widest text-[var(--text-primary)] uppercase flex items-center gap-3 font-heading">
            <span class="w-2 h-2 rounded-full bg-[#DC2626]"></span>
            <span>{item}</span>
          </span>
          <span class="text-xs font-mono font-bold text-amber-500 uppercase tracking-widest">// SERVITOTALES</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Business Divisions Portal Grid -->
  <section class="py-20 lg:py-28 relative border-b border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14 space-y-3">
        <span class="tech-label">01 // DIVISIONES OPERATIVAS & SGC ISO 9001</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[var(--text-primary)] leading-tight font-heading">
          Soluciones Integrales para Minería, Construcción e Industria
        </h2>
        <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
          Unidades de negocio homologadas para proyectos en costa, sierra y selva con despacho directo en obra.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="p-8 rounded-3xl industrial-card flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-red-500/10 border border-red-500/30 flex items-center justify-center text-[#DC2626] mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
              </svg>
            </div>
            <span class="text-xs font-mono font-bold text-[#DC2626] uppercase">División Maquinaria</span>
            <h3 class="text-2xl font-black text-[var(--text-primary)] mt-1 mb-3 font-heading group-hover:text-[#DC2626] transition-colors">
              Maquinaria Pesada & Minería
            </h3>
            <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
              Excavadoras, cargadores, volquetes, telehandlers y sistemas para minería subterránea trackless.
            </p>
          </div>
          <div class="pt-5 border-t border-[var(--border-subtle)]">
            <a href="/maquinaria" class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-[#DC2626] group-hover:translate-x-1 transition-all">
              <span>Ver Catálogo de Flota</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </a>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="p-8 rounded-3xl industrial-card flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-500 mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <span class="text-xs font-mono font-bold text-amber-500 uppercase">Seguridad Industrial</span>
            <h3 class="text-2xl font-black text-[var(--text-primary)] mt-1 mb-3 font-heading group-hover:text-amber-500 transition-colors">
              Equipos de Protección (EPP)
            </h3>
            <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
              Cascos, respiradores con filtros P100, arneses anticaídas, trajes Tyvek e indumentaria ignífuga.
            </p>
          </div>
          <div class="pt-5 border-t border-[var(--border-subtle)]">
            <a href="/epp" class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-amber-500 group-hover:translate-x-1 transition-all">
              <span>Ver Catálogo de EPP</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </a>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="p-8 rounded-3xl industrial-card flex flex-col justify-between group">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-blue-600/10 border border-blue-500/30 flex items-center justify-center text-blue-600 dark:text-blue-400 mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <span class="text-xs font-mono font-bold text-blue-600 dark:text-blue-400 uppercase">Ferretería & Mobiliario</span>
            <h3 class="text-2xl font-black text-[var(--text-primary)] mt-1 mb-3 font-heading group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              Ferretería & Suministros
            </h3>
            <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
              Herramientas, pernos estructurales, abrasivos, pinturas epóxicas y mobiliario de campamento.
            </p>
          </div>
          <div class="pt-5 border-t border-[var(--border-subtle)]">
            <a href="/suministros" class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-blue-600 dark:text-blue-400 group-hover:translate-x-1 transition-all">
              <span>Ver Suministros</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>