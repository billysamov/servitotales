---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Panel de Control Administrativo | SERVITOTALES S.A.C."
  description="Gestión integral de flota pesada, solicitudes de cotizaciones, inventario de EPP, suministros y operadores homologados."
>
  <div class="min-h-screen bg-[var(--bg-main)] py-8 px-4 sm:px-6 lg:px-8" id="admin-app">
    <div class="max-w-7xl mx-auto space-y-8">
      
      <!-- Top Admin Header Bar -->
      <div class="p-6 rounded-3xl industrial-card shadow-xl flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-[#DC2626] text-white flex items-center justify-center font-bold text-xl shadow-lg">
            ST
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-xl sm:text-2xl font-black text-[var(--text-primary)] font-heading">
                Panel de Operaciones & Control
              </h1>
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 font-mono text-[10px] font-bold">
                EN LÍNEA
              </span>
            </div>
            <p class="text-xs text-[var(--text-secondary)]">
              Servicios Totales del Perú S.A.C. • SGC ISO 9001:2015
            </p>
          </div>
        </div>

        <div class="flex items-center gap-3 self-end md:self-auto">
          <div class="text-right hidden sm:block">
            <span class="text-[11px] font-bold text-[var(--text-primary)] block font-mono" id="admin-user-display">admin@servitotales.com</span>
            <span class="text-[10px] text-slate-400">Rol: Administrador General</span>
          </div>
          <button
            type="button"
            id="btn-admin-logout"
            class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-bold hover:bg-red-500 hover:text-white transition-colors cursor-pointer flex items-center gap-2 border border-slate-200 dark:border-slate-700"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </div>

      <!-- Executive KPI Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- KPI 1: Cotizaciones Recibidas -->
        <div class="p-5 rounded-3xl industrial-card shadow-md space-y-2 border-l-4 border-blue-500">
          <div class="flex items-center justify-between text-slate-400">
            <span class="text-xs font-mono font-bold uppercase">Cotizaciones Web</span>
            <span class="text-xl">📋</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-black text-[var(--text-primary)] font-heading" id="kpi-leads-count">12</span>
            <span class="text-xs font-bold text-emerald-500">+3 hoy</span>
          </div>
          <span class="text-[11px] text-[var(--text-secondary)] block">4 pendientes de respuesta técnica</span>
        </div>

        <!-- KPI 2: Flota de Maquinaria -->
        <div class="p-5 rounded-3xl industrial-card shadow-md space-y-2 border-l-4 border-[#DC2626]">
          <div class="flex items-center justify-between text-slate-400">
            <span class="text-xs font-mono font-bold uppercase">Flota en Operación</span>
            <span class="text-xl">🚜</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-black text-[var(--text-primary)] font-heading">28 / 34</span>
            <span class="text-xs font-bold text-blue-500">82% Activa</span>
          </div>
          <span class="text-[11px] text-[var(--text-secondary)] block">6 unidades disponibles en patio</span>
        </div>

        <!-- KPI 3: Stock de EPP & Suministros -->
        <div class="p-5 rounded-3xl industrial-card shadow-md space-y-2 border-l-4 border-amber-500">
          <div class="flex items-center justify-between text-slate-400">
            <span class="text-xs font-mono font-bold uppercase">Almacén Central EPP</span>
            <span class="text-xl">🦺</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-black text-[var(--text-primary)] font-heading">1,450</span>
            <span class="text-xs font-bold text-amber-500">Kits OK</span>
          </div>
          <span class="text-[11px] text-[var(--text-secondary)] block">Stock óptimo para despachos inmediatos</span>
        </div>

        <!-- KPI 4: Homologación & Calidad -->
        <div class="p-5 rounded-3xl industrial-card shadow-md space-y-2 border-l-4 border-emerald-500">
          <div class="flex items-center justify-between text-slate-400">
            <span class="text-xs font-mono font-bold uppercase">SGC ISO 9001:2015</span>
            <span class="text-xl">🛡️</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-black text-emerald-500 font-heading">100%</span>
            <span class="text-xs font-bold text-emerald-500">Vigente</span>
          </div>
          <span class="text-[11px] text-[var(--text-secondary)] block">Auditoría y telemetría al día</span>
        </div>
      </div>

      <!-- Interactive Tabbed Workspace -->
      <div class="p-6 sm:p-8 rounded-3xl industrial-card shadow-2xl space-y-6">
        <!-- Navigation Tab Pills -->
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[var(--border-subtle)] pb-4">
          <div class="flex flex-wrap items-center gap-2" id="admin-tabs-nav">
            <button
              type="button"
              data-tab="leads"
              class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 cursor-pointer bg-[#DC2626] text-white shadow-md"
            >
              📋 Mesa de Cotizaciones (Leads)
            </button>
            <button
              type="button"
              data-tab="fleet"
              class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 cursor-pointer bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white"
            >
              🚜 Flota de Maquinaria & Minería
            </button>
            <button
              type="button"
              data-tab="inventory"
              class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 cursor-pointer bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white"
            >
              🦺 Inventario EPP & Suministros
            </button>
            <button
              type="button"
              data-tab="operators"
              class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 cursor-pointer bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white"
            >
              👷 Operadores & SST
            </button>
          </div>

          <div class="flex items-center gap-3">
            <input
              type="text"
              id="admin-search-input"
              placeholder="Buscar por cliente, equipo o SKU..."
              class="px-3.5 py-1.5 rounded-xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-xs focus:outline-none focus:border-[#DC2626] transition w-56"
            />
            <button
              type="button"
              id="btn-export-csv"
              class="px-3 py-1.5 rounded-xl border border-emerald-500/40 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold hover:bg-emerald-500 hover:text-white transition flex items-center gap-1.5 cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              <span>Exportar CSV</span>
            </button>
          </div>
        </div>

        <!-- TAB 1: MESA DE COTIZACIONES (LEADS) -->
        <div id="tab-content-leads" class="tab-panel space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-base font-bold text-[var(--text-primary)]">
              Solicitudes Recientes de Cotización Técnica
            </h3>
            <span class="text-xs text-[var(--text-secondary)]">Actualizado en tiempo real</span>
          </div>

          <div class="overflow-x-auto rounded-2xl border border-[var(--border-subtle)]">
            <table class="w-full text-left text-xs text-[var(--text-secondary)]">
              <thead class="bg-slate-100 dark:bg-slate-900/80 text-[11px] uppercase font-mono font-bold text-[var(--text-primary)] border-b border-[var(--border-subtle)]">
                <tr>
                  <th class="p-3.5">Fecha</th>
                  <th class="p-3.5">Cliente / Empresa</th>
                  <th class="p-3.5">División</th>
                  <th class="p-3.5">Ubicación / Obra</th>
                  <th class="p-3.5">Contacto</th>
                  <th class="p-3.5">Estado</th>
                  <th class="p-3.5 text-right">Acción</th>
                </tr>
              </thead>
              <tbody id="leads-table-body" class="divide-y divide-[var(--border-subtle)] bg-[var(--bg-surface)]">
                <!-- Rows injected via JS -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- TAB 2: FLOTA DE MAQUINARIA PESADA -->
        <div id="tab-content-fleet" class="tab-panel hidden space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <h3 class="text-base font-bold text-[var(--text-primary)]">
                Control de Flota y Disponibilidad Operativa
              </h3>
              <p class="text-xs text-[var(--text-secondary)]">Monitoreo de equipos pesados, unidades trackless y generadores.</p>
            </div>
            <button
              type="button"
              id="btn-add-machine"
              class="px-4 py-2 rounded-xl bg-[#DC2626] text-white text-xs font-bold hover:bg-[#B91C1C] transition shadow cursor-pointer flex items-center gap-1.5"
            >
              <span>+ Registrar Nuevo Equipo</span>
            </button>
          </div>

          <div class="overflow-x-auto rounded-2xl border border-[var(--border-subtle)]">
            <table class="w-full text-left text-xs text-[var(--text-secondary)]">
              <thead class="bg-slate-100 dark:bg-slate-900/80 text-[11px] uppercase font-mono font-bold text-[var(--text-primary)] border-b border-[var(--border-subtle)]">
                <tr>
                  <th class="p-3.5">Cód. Equipo</th>
                  <th class="p-3.5">Modelo / Tipo</th>
                  <th class="p-3.5">Categoría</th>
                  <th class="p-3.5">Ubicación Actual</th>
                  <th class="p-3.5">Horómetro</th>
                  <th class="p-3.5">Estado Operativo</th>
                  <th class="p-3.5 text-right">Acción</th>
                </tr>
              </thead>
              <tbody id="fleet-table-body" class="divide-y divide-[var(--border-subtle)] bg-[var(--bg-surface)]">
                <!-- Fleet rows injected via JS -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- TAB 3: INVENTARIO EPP & SUMINISTROS -->
        <div id="tab-content-inventory" class="tab-panel hidden space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <h3 class="text-base font-bold text-[var(--text-primary)]">
                Control de Stock de Almacén Central (EPP y Ferretería)
              </h3>
              <p class="text-xs text-[var(--text-secondary)]">Kits normados ANSI/OSHA, pernos estructurales y herramientas industriales.</p>
            </div>
            <button
              type="button"
              id="btn-add-stock"
              class="px-4 py-2 rounded-xl bg-blue-600 text-white text-xs font-bold hover:bg-blue-700 transition shadow cursor-pointer flex items-center gap-1.5"
            >
              <span>+ Añadir Lote al Inventario</span>
            </button>
          </div>

          <div class="overflow-x-auto rounded-2xl border border-[var(--border-subtle)]">
            <table class="w-full text-left text-xs text-[var(--text-secondary)]">
              <thead class="bg-slate-100 dark:bg-slate-900/80 text-[11px] uppercase font-mono font-bold text-[var(--text-primary)] border-b border-[var(--border-subtle)]">
                <tr>
                  <th class="p-3.5">SKU / Código</th>
                  <th class="p-3.5">Descripción del Producto</th>
                  <th class="p-3.5">Categoría / Marca</th>
                  <th class="p-3.5">Stock Disponible</th>
                  <th class="p-3.5">U.M.</th>
                  <th class="p-3.5">Nivel de Stock</th>
                  <th class="p-3.5 text-right">Ajuste</th>
                </tr>
              </thead>
              <tbody id="inventory-table-body" class="divide-y divide-[var(--border-subtle)] bg-[var(--bg-surface)]">
                <!-- Inventory rows injected via JS -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- TAB 4: OPERADORES & SST -->
        <div id="tab-content-operators" class="tab-panel hidden space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <h3 class="text-base font-bold text-[var(--text-primary)]">
                Personal Técnico & Operadores Homologados
              </h3>
              <p class="text-xs text-[var(--text-secondary)]">Cumplimiento del SGC ISO 9001:2015, EMO y licencias especiales para minería.</p>
            </div>
            <button
              type="button"
              id="btn-add-operator"
              class="px-4 py-2 rounded-xl bg-amber-500 text-white text-xs font-bold hover:bg-amber-600 transition shadow cursor-pointer flex items-center gap-1.5"
            >
              <span>+ Registrar Operador</span>
            </button>
          </div>

          <div class="overflow-x-auto rounded-2xl border border-[var(--border-subtle)]">
            <table class="w-full text-left text-xs text-[var(--text-secondary)]">
              <thead class="bg-slate-100 dark:bg-slate-900/80 text-[11px] uppercase font-mono font-bold text-[var(--text-primary)] border-b border-[var(--border-subtle)]">
                <tr>
                  <th class="p-3.5">DNI</th>
                  <th class="p-3.5">Nombre del Operador</th>
                  <th class="p-3.5">Especialidad de Máquina</th>
                  <th class="p-3.5">Homologación Minera</th>
                  <th class="p-3.5">Vigencia EMO</th>
                  <th class="p-3.5">Estado Asignación</th>
                </tr>
              </thead>
              <tbody id="operators-table-body" class="divide-y divide-[var(--border-subtle)] bg-[var(--bg-surface)]">
                <!-- Operators rows injected via JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Authentication Guard
  if (localStorage.getItem('servitotales_admin_auth') !== 'true') {
    window.location.href = '/login';
  }

  // Logout Handler
  document.getElementById('btn-admin-logout')?.addEventListener('click', () => {
    localStorage.removeItem('servitotales_admin_auth');
    localStorage.removeItem('servitotales_admin_user');
    window.location.href = '/login';
  });

  const currentUser = localStorage.getItem('servitotales_admin_user') || 'admin@servitotales.com';
  const userDisplay = document.getElementById('admin-user-display');
  if (userDisplay) userDisplay.textContent = currentUser;

  // Mock Database State with LocalStorage Persistence
  const initialLeads = [
    { id: 1, date: '29/08/2026', client: 'Ing. Carlos Mendoza', company: 'Consorcio Vial Junín', division: 'Maquinaria Pesada', location: 'Huancayo - Mina Yauli', phone: '+51 987 654 321', status: 'Pendiente', details: 'Alquiler de 2 Excavadoras CAT 336D por 6 meses con operador.' },
    { id: 2, date: '29/08/2026', client: 'Ing. Lucía Paredes', company: 'Minera Las Cumbres SAC', division: 'Seguridad & EPP', location: 'Arequipa - Cerro Verde', phone: '+51 965 412 879', status: 'En Evaluación', details: 'Lote de 300 respiradores 3M 6200 con filtros 2097 P100.' },
    { id: 3, date: '28/08/2026', client: 'Ing. Roberto Silva', company: 'Constructora del Sur EIRL', division: 'Ferretería & Suministros', location: 'Cusco - Espinar', phone: '+51 974 582 143', status: 'Cotizado', details: '50 millares de pernos hexagonales estructurales A325.' },
    { id: 4, date: '27/08/2026', client: 'Ing. Raúl Huamán', company: 'Subterránea Minera SAC', division: 'Maquinaria Trackless', location: 'Pasco - San Cristóbal', phone: '+51 912 345 678', status: 'Aprobado', details: 'Alquiler de Jumbo Electrohidráulico 2 brazos con mantenimiento.' }
  ];

  const initialFleet = [
    { code: 'EXC-01', model: 'Excavadora CAT 336D (36 Tn)', category: 'Línea Amarilla', location: 'Mina Toromocho - Junín', hours: '4,120 hrs', status: 'En Operación' },
    { code: 'EXC-02', model: 'Excavadora Komatsu PC350LC', category: 'Línea Amarilla', location: 'Patio Central Lima', hours: '1,890 hrs', status: 'Disponible' },
    { code: 'JMB-01', model: 'Jumbo Sandvik DD321 (2 Brazos)', category: 'Minería Trackless', location: 'Mina Yauli - Pasco', hours: '2,450 hrs', status: 'En Operación' },
    { code: 'SCP-01', model: 'Scooptram Epiroc ST1030 (10 Tn)', category: 'Minería Trackless', location: 'Mina Huancavelica', hours: '3,800 hrs', status: 'En Operación' },
    { code: 'GEN-01', model: 'Grupo Electrógeno Cummins 250 kVA', category: 'Energía & Soporte', location: 'Patio Central Lima', hours: '850 hrs', status: 'Disponible' },
    { code: 'ROD-01', model: 'Rodillo Compactador CAT CS533E', category: 'Línea Amarilla', location: 'Taller Mantenimiento', hours: '5,200 hrs', status: 'Mantenimiento' }
  ];

  const initialInventory = [
    { sku: 'EPP-3M-6200', name: 'Respirador Media Cara 3M Serie 6200', category: 'Protección Respiratoria', stock: 450, um: 'Und.', level: 'Óptimo' },
    { sku: 'EPP-FIL-2097', name: 'Filtro de Alta Eficiencia 3M 2097 P100', category: 'Filtros & Cartuchos', stock: 1200, um: 'Pares', level: 'Óptimo' },
    { sku: 'EPP-ARN-4A', name: 'Arnés de Seguridad 4 Anillos Dieléctrico ANSI', category: 'Trabajo en Altura', stock: 85, um: 'Und.', level: 'Alerta Reposición' },
    { sku: 'FER-PRN-A325', name: 'Perno Estructural Grado A325 3/4" x 3"', category: 'Ferretería Pesada', stock: 25000, um: 'Und.', level: 'Óptimo' },
    { sku: 'FER-DSC-09', name: 'Disco de Corte Inox Norton 9"', category: 'Abrasivos', stock: 320, um: 'Cajas', level: 'Óptimo' },
    { sku: 'EPP-CAS-MSA', name: 'Casco Dieléctrico V-Gard MSA Tipo I Clase E', category: 'Protección Craneana', stock: 40, um: 'Und.', level: 'Crítico' }
  ];

  const initialOperators = [
    { dni: '45892147', name: 'Marco Antonio Vilca', machine: 'Excavadora CAT 336D / 349D', cert: 'Certificado CETEMIN • Homologado Volcan', emo: 'Vigente (Jun 2027)', status: 'Asignado a Obra' },
    { dni: '71254896', name: 'Edgar Quispe Rojas', machine: 'Jumbo Subterráneo Sandvik / Epiroc', cert: 'Homologado Antamina • Categoría Especial', emo: 'Vigente (Ene 2027)', status: 'Asignado a Obra' },
    { dni: '40215879', name: 'Víctor Fernández Cárdenas', machine: 'Scooptram ST1030 / ST14', cert: 'Homologación Nexa Resources', emo: 'Vigente (Sep 2026)', status: 'Disponible en Base' },
    { dni: '48963251', name: 'Jorge Luis Huayta', machine: 'Cargador Frontal CAT 966H', cert: 'Certificado Tecsup • Homologado Minsur', emo: 'Vigente (Dic 2026)', status: 'Disponible en Base' }
  ];

  // Render Leads Table
  function renderLeads(leads: any[]) {
    const tbody = document.getElementById('leads-table-body');
    if (!tbody) return;
    tbody.innerHTML = leads.map(lead => {
      let badgeClass = 'bg-blue-500/10 text-blue-500 border-blue-500/30';
      if (lead.status === 'Cotizado') badgeClass = 'bg-amber-500/10 text-amber-500 border-amber-500/30';
      if (lead.status === 'Aprobado') badgeClass = 'bg-emerald-500/10 text-emerald-500 border-emerald-500/30';

      return `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
          <td class="p-3.5 font-mono text-[11px] text-slate-400">${lead.date}</td>
          <td class="p-3.5">
            <span class="font-bold text-[var(--text-primary)] block">${lead.client}</span>
            <span class="text-[10px] text-slate-400 font-mono">${lead.company}</span>
          </td>
          <td class="p-3.5 font-semibold text-[var(--text-primary)]">${lead.division}</td>
          <td class="p-3.5 text-slate-400">${lead.location}</td>
          <td class="p-3.5 font-mono text-[11px] text-blue-500">${lead.phone}</td>
          <td class="p-3.5">
            <span class="px-2.5 py-0.5 rounded-full border text-[10px] font-bold ${badgeClass}">
              ${lead.status}
            </span>
          </td>
          <td class="p-3.5 text-right space-x-2">
            <button
              type="button"
              onclick="window.open('https://wa.me/51963895085?text=' + encodeURIComponent('Hola ${lead.client} de ${lead.company}, le contactamos de Servitotales S.A.C. respecto a su requerimiento de ${lead.division}.'), '_blank')"
              class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-600 hover:bg-emerald-500 hover:text-white transition text-[10px] font-bold border border-emerald-500/30"
            >
              WhatsApp
            </button>
          </td>
        </tr>
      `;
    }).join('');
  }

  // Render Fleet Table
  function renderFleet(fleet: any[]) {
    const tbody = document.getElementById('fleet-table-body');
    if (!tbody) return;
    tbody.innerHTML = fleet.map(item => {
      let statusBadge = 'bg-emerald-500/10 text-emerald-500 border-emerald-500/30';
      if (item.status === 'En Operación') statusBadge = 'bg-blue-500/10 text-blue-500 border-blue-500/30';
      if (item.status === 'Mantenimiento') statusBadge = 'bg-red-500/10 text-red-500 border-red-500/30';

      return `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
          <td class="p-3.5 font-mono font-bold text-red-500">${item.code}</td>
          <td class="p-3.5 font-bold text-[var(--text-primary)]">${item.model}</td>
          <td class="p-3.5 text-slate-400 font-mono text-[11px]">${item.category}</td>
          <td class="p-3.5 text-slate-400">${item.location}</td>
          <td class="p-3.5 font-mono text-[11px] text-[var(--text-primary)]">${item.hours}</td>
          <td class="p-3.5">
            <span class="px-2.5 py-0.5 rounded-full border text-[10px] font-bold ${statusBadge}">
              ${item.status}
            </span>
          </td>
          <td class="p-3.5 text-right">
            <button
              type="button"
              onclick="alert('Estado del equipo ${item.code} actualizado en telemetría.')"
              class="px-2.5 py-1 rounded-lg bg-slate-200 dark:bg-slate-800 text-[var(--text-primary)] hover:bg-red-500 hover:text-white transition text-[10px] font-bold"
            >
              Editar Estado
            </button>
          </td>
        </tr>
      `;
    }).join('');
  }

  // Render Inventory Table
  function renderInventory(inv: any[]) {
    const tbody = document.getElementById('inventory-table-body');
    if (!tbody) return;
    tbody.innerHTML = inv.map(item => {
      let levelBadge = 'bg-emerald-500/10 text-emerald-500 border-emerald-500/30';
      if (item.level === 'Alerta Reposición') levelBadge = 'bg-amber-500/10 text-amber-500 border-amber-500/30';
      if (item.level === 'Crítico') levelBadge = 'bg-red-500/10 text-red-500 border-red-500/30';

      return `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
          <td class="p-3.5 font-mono font-bold text-blue-500">${item.sku}</td>
          <td class="p-3.5 font-bold text-[var(--text-primary)]">${item.name}</td>
          <td class="p-3.5 text-slate-400 text-[11px]">${item.category}</td>
          <td class="p-3.5 font-black text-[var(--text-primary)] text-sm">${item.stock.toLocaleString()}</td>
          <td class="p-3.5 font-mono text-[11px] text-slate-400">${item.um}</td>
          <td class="p-3.5">
            <span class="px-2.5 py-0.5 rounded-full border text-[10px] font-bold ${levelBadge}">
              ${item.level}
            </span>
          </td>
          <td class="p-3.5 text-right">
            <button
              type="button"
              onclick="const cant = prompt('Ingresa la cantidad a ingresar o retirar para ' + '${item.sku}' + ':'); if(cant) alert('Stock de ' + '${item.sku}' + ' actualizado con éxito.');"
              class="px-2.5 py-1 rounded-lg bg-blue-500/10 text-blue-500 hover:bg-blue-500 hover:text-white transition text-[10px] font-bold border border-blue-500/30"
            >
              + Ajustar Stock
            </button>
          </td>
        </tr>
      `;
    }).join('');
  }

  // Render Operators Table
  function renderOperators(ops: any[]) {
    const tbody = document.getElementById('operators-table-body');
    if (!tbody) return;
    tbody.innerHTML = ops.map(op => {
      const isAssigned = op.status === 'Asignado a Obra';
      return `
        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
          <td class="p-3.5 font-mono text-[11px] text-slate-400">${op.dni}</td>
          <td class="p-3.5 font-bold text-[var(--text-primary)]">${op.name}</td>
          <td class="p-3.5 text-slate-300 font-semibold">${op.machine}</td>
          <td class="p-3.5 text-[11px] text-amber-500 font-mono">${op.cert}</td>
          <td class="p-3.5 font-mono text-[11px] text-emerald-500">${op.emo}</td>
          <td class="p-3.5">
            <span class="px-2.5 py-0.5 rounded-full border text-[10px] font-bold ${isAssigned ? 'bg-blue-500/10 text-blue-500 border-blue-500/30' : 'bg-emerald-500/10 text-emerald-500 border-emerald-500/30'}">
              ${op.status}
            </span>
          </td>
        </tr>
      `;
    }).join('');
  }

  // Initialize Tables
  renderLeads(initialLeads);
  renderFleet(initialFleet);
  renderInventory(initialInventory);
  renderOperators(initialOperators);

  // Tab Navigation Handling
  const tabBtns = document.querySelectorAll('#admin-tabs-nav .tab-btn');
  const tabPanels = document.querySelectorAll('.tab-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = btn.getAttribute('data-tab');

      tabBtns.forEach(b => {
        b.className = 'tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 cursor-pointer bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white';
      });
      btn.className = 'tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all duration-200 cursor-pointer bg-[#DC2626] text-white shadow-md';

      tabPanels.forEach(p => p.classList.add('hidden'));
      const activePanel = document.getElementById(`tab-content-${tab}`);
      if (activePanel) activePanel.classList.remove('hidden');
    });
  });

  // Search Filter Handler
  const searchInput = document.getElementById('admin-search-input') as HTMLInputElement;
  searchInput?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
    
    const filteredLeads = initialLeads.filter(l => 
      l.client.toLowerCase().includes(q) || 
      l.company.toLowerCase().includes(q) || 
      l.division.toLowerCase().includes(q) ||
      l.location.toLowerCase().includes(q)
    );
    renderLeads(filteredLeads);

    const filteredFleet = initialFleet.filter(f =>
      f.code.toLowerCase().includes(q) ||
      f.model.toLowerCase().includes(q) ||
      f.category.toLowerCase().includes(q) ||
      f.location.toLowerCase().includes(q)
    );
    renderFleet(filteredFleet);

    const filteredInv = initialInventory.filter(i =>
      i.sku.toLowerCase().includes(q) ||
      i.name.toLowerCase().includes(q) ||
      i.category.toLowerCase().includes(q)
    );
    renderInventory(filteredInv);
  });

  // Export CSV Handler
  document.getElementById('btn-export-csv')?.addEventListener('click', () => {
    const csvContent = "data:text/csv;charset=utf-8," 
      + "Fecha,Cliente,Empresa,Division,Ubicacion,Telefono,Estado\n"
      + initialLeads.map(e => `"${e.date}","${e.client}","${e.company}","${e.division}","${e.location}","${e.phone}","${e.status}"`).join("\n");
    
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", "servitotales_cotizaciones_reporte.csv");
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  // Quick Action Modals
  document.getElementById('btn-add-machine')?.addEventListener('click', () => {
    const code = prompt('Código del equipo (ej. EXC-03):');
    const model = prompt('Modelo y tonelaje (ej. Excavadora CAT 349D 50Tn):');
    const loc = prompt('Ubicación (ej. Mina Las Bambas):');
    if (code && model) {
      initialFleet.unshift({
        code: code.toUpperCase(),
        model: model,
        category: 'Línea Amarilla',
        location: loc || 'Patio Central',
        hours: '0 hrs',
        status: 'Disponible'
      });
      renderFleet(initialFleet);
      alert('Equipo ' + code + ' registrado exitosamente en la flota.');
    }
  });

  document.getElementById('btn-add-stock')?.addEventListener('click', () => {
    const sku = prompt('Código SKU (ej. EPP-CAS-02):');
    const name = prompt('Nombre o descripción del producto:');
    const qty = prompt('Cantidad inicial:');
    if (sku && name) {
      initialInventory.unshift({
        sku: sku.toUpperCase(),
        name: name,
        category: 'Seguridad & EPP',
        stock: parseInt(qty || '100'),
        um: 'Und.',
        level: 'Óptimo'
      });
      renderInventory(initialInventory);
      alert('Lote ' + sku + ' añadido al inventario central.');
    }
  });

  document.getElementById('btn-add-operator')?.addEventListener('click', () => {
    const dni = prompt('DNI del operador:');
    const name = prompt('Nombre y apellido:');
    const machine = prompt('Especialidad de maquinaria:');
    if (dni && name) {
      initialOperators.unshift({
        dni: dni,
        name: name,
        machine: machine || 'Maquinaria Pesada',
        cert: 'Certificado y Homologado SGC ISO 9001',
        emo: 'Vigente (2027)',
        status: 'Disponible en Base'
      });
      renderOperators(initialOperators);
      alert('Operador ' + name + ' registrado correctamente.');
    }
  });
</script>
