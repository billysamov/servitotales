---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Mesa de Cotizaciones & Propuestas Técnicas | SERVITOTALES S.A.C."
  description="Plataforma de postulación y formulación de propuestas técnicas de maquinaria pesada, lotes de EPP y suministros industriales. Certificación ISO 9001:2015."
>
  <!-- Atmospheric Hero Header -->
  <section class="relative py-16 lg:py-24 border-b border-slate-800/80 bg-[#050A14] overflow-hidden text-white">
    <div class="absolute inset-0 w-full h-full z-0 overflow-hidden pointer-events-none select-none">
      <img
        src="/images/hero-contacto.jpg"
        alt="Centro de operaciones y despacho logístico Servitotales S.A.C."
        loading="eager"
        decoding="async"
        class="w-full h-full object-cover opacity-35 contrast-115 saturate-110"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#050A14] via-[#050A14]/85 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#050A14] via-transparent to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4" id="contacto-hero">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-600/20 border border-red-500/35 text-red-400 font-mono text-[11px] font-bold tracking-wider uppercase">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          06 // SISTEMA INTEGRAL DE PROPUESTAS & COTIZACIÓN
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-white font-heading leading-tight">
          Formulación de Propuestas Técnicas en Línea
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
          Genera tu requerimiento técnico oficial en 3 pasos interactivos con evaluación inmediata de disponibilidad y logística para proyectos a nivel nacional.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive 3-Step Wizard Section -->
  <section class="py-16 lg:py-24 border-b border-[var(--border-subtle)] bg-[var(--bg-main)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Stepper Navigation Bar (Reinventada con 3 Secciones) -->
      <div class="p-2 sm:p-2.5 rounded-2xl sm:rounded-full bg-white dark:bg-[#0A1324] border border-slate-200 dark:border-slate-800 shadow-xl mb-10">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2" id="stepper-bar">
          <!-- Step 1 Tab -->
          <button
            type="button"
            data-step="1"
            class="step-tab flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl sm:rounded-full text-xs font-bold transition-all duration-300 cursor-pointer bg-blue-600 text-white shadow-md"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span class="whitespace-nowrap">Información detallada</span>
          </button>

          <!-- Step 2 Tab -->
          <button
            type="button"
            data-step="2"
            class="step-tab flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl sm:rounded-full text-xs font-bold transition-all duration-300 cursor-pointer text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
            </svg>
            <span class="whitespace-nowrap">Llenado de la propuesta</span>
          </button>

          <!-- Step 3 Tab -->
          <button
            type="button"
            data-step="3"
            class="step-tab flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl sm:rounded-full text-xs font-bold transition-all duration-300 cursor-pointer text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
            <span class="whitespace-nowrap">Presentación de la oferta</span>
          </button>
        </div>
      </div>

      <!-- Main Step Form Box -->
      <div class="p-6 sm:p-12 rounded-3xl industrial-card shadow-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] relative overflow-hidden">
        <form id="proposal-wizard-form">
          
          <!-- STEP 1: INFORMACIÓN DETALLADA -->
          <div id="step-content-1" class="step-panel space-y-8 animate-in fade-in duration-300">
            <div class="border-b border-[var(--border-subtle)] pb-4">
              <span class="text-xs font-mono font-bold text-blue-600 dark:text-blue-400 uppercase tracking-wider block">Paso 01 // Registro</span>
              <h2 class="text-2xl sm:text-3xl font-black text-[var(--text-primary)] font-heading mt-1">
                Datos del Cliente y Ubicación del Proyecto
              </h2>
              <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-1">
                Ingresa la información fiscal y técnica para la emisión formal de la cotización técnica.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="client_name" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2">Nombre y Apellido del Responsable *</label>
                <input type="text" id="client_name" name="client_name" required placeholder="Ej. Ing. Marco Antonio Paredes" class="w-full px-4 py-3.5 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition" />
              </div>

              <div>
                <label for="company_ruc" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2">Razón Social y RUC *</label>
                <input type="text" id="company_ruc" name="company_ruc" required placeholder="Ej. Consorcio Minero del Centro - 20601234567" class="w-full px-4 py-3.5 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition" />
              </div>

              <div>
                <label for="client_phone" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2">Teléfono Celular Directo *</label>
                <input type="tel" id="client_phone" name="client_phone" required placeholder="Ej. 987 654 321" class="w-full px-4 py-3.5 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition" />
              </div>

              <div>
                <label for="client_email" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2">Correo Corporativo *</label>
                <input type="email" id="client_email" name="client_email" required placeholder="mparedes@empresa.com.pe" class="w-full px-4 py-3.5 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition" />
              </div>

              <div class="sm:col-span-2">
                <label for="project_location" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2">Ubicación de la Obra o Proyecto (Mina / Región / Distrito) *</label>
                <input type="text" id="project_location" name="project_location" required placeholder="Ej. Mina Las Bambas - Apurímac / Proyecto Vial Huancayo" class="w-full px-4 py-3.5 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 transition" />
              </div>
            </div>

            <div class="pt-6 border-t border-[var(--border-subtle)] flex justify-end">
              <button
                type="button"
                id="btn-goto-step-2"
                class="px-8 py-3.5 text-xs font-black uppercase tracking-wider text-white bg-blue-600 hover:bg-blue-700 rounded-2xl shadow-lg hover:-translate-y-0.5 transition-all flex items-center gap-2 cursor-pointer"
              >
                <span>Continuar a Llenado de Propuesta</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </button>
            </div>
          </div>

          <!-- STEP 2: LLENADO DE LA PROPUESTA -->
          <div id="step-content-2" class="step-panel hidden space-y-8 animate-in fade-in duration-300">
            <div class="border-b border-[var(--border-subtle)] pb-4">
              <span class="text-xs font-mono font-bold text-amber-500 uppercase tracking-wider block">Paso 02 // Formulación</span>
              <h2 class="text-2xl sm:text-3xl font-black text-[var(--text-primary)] font-heading mt-1">
                Configuración y Especificación del Requerimiento
              </h2>
              <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-1">
                Selecciona la división de negocio, modalidad de trabajo y detalla las máquinas o insumos requeridos.
              </p>
            </div>

            <!-- Division Selector Interactive Pills -->
            <div class="space-y-3">
              <label class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider">Línea o División Principal *</label>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4" id="division-selector-cards">
                <label class="p-4 rounded-2xl border-2 border-red-500 bg-red-500/10 cursor-pointer flex flex-col justify-between transition-all group division-radio-label">
                  <input type="radio" name="proposal_division" value="Maquinaria Pesada & Minería" checked class="sr-only" />
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xl">🚜</span>
                    <span class="w-4 h-4 rounded-full border-2 border-[#DC2626] bg-[#DC2626] flex items-center justify-center text-white text-[9px] radio-dot">✓</span>
                  </div>
                  <span class="text-xs font-bold text-[var(--text-primary)]">Maquinaria & Minería</span>
                  <span class="text-[10px] text-[var(--text-secondary)] mt-1 leading-tight">Excavadoras, volquetes, scooptrams, jumbos.</span>
                </label>

                <label class="p-4 rounded-2xl border border-[var(--border-strong)] bg-[var(--bg-main)] cursor-pointer flex flex-col justify-between transition-all group division-radio-label hover:border-amber-500">
                  <input type="radio" name="proposal_division" value="Equipos de Protección (EPP)" class="sr-only" />
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xl">🦺</span>
                    <span class="w-4 h-4 rounded-full border-2 border-slate-400 flex items-center justify-center text-white text-[9px] radio-dot"></span>
                  </div>
                  <span class="text-xs font-bold text-[var(--text-primary)]">Seguridad & EPP</span>
                  <span class="text-[10px] text-[var(--text-secondary)] mt-1 leading-tight">Respiradores 3M, cascos, arneses, trajes.</span>
                </label>

                <label class="p-4 rounded-2xl border border-[var(--border-strong)] bg-[var(--bg-main)] cursor-pointer flex flex-col justify-between transition-all group division-radio-label hover:border-blue-500">
                  <input type="radio" name="proposal_division" value="Ferretería & Suministros" class="sr-only" />
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-xl">🔩</span>
                    <span class="w-4 h-4 rounded-full border-2 border-slate-400 flex items-center justify-center text-white text-[9px] radio-dot"></span>
                  </div>
                  <span class="text-xs font-bold text-[var(--text-primary)]">Ferretería & Suministros</span>
                  <span class="text-[10px] text-[var(--text-secondary)] mt-1 leading-tight">Pernos A325, abrasivos, mobiliario.</span>
                </label>
              </div>
            </div>

            <!-- Operation Modality & Timeframe -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div>
                <label for="operation_modality" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2">Modalidad Requerida *</label>
                <select id="operation_modality" name="operation_modality" class="w-full px-4 py-3.5 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-amber-500 transition">
                  <option value="Alquiler con Operador Homologado y Combustible">Alquiler con Operador Homologado</option>
                  <option value="Alquiler Equipo Seco (Sin Operador)">Alquiler Equipo Seco (Sin Operador)</option>
                  <option value="Suministro / Venta Mayorista por Lote">Suministro / Venta Mayorista por Lote</option>
                  <option value="Servicio Integral de Mantenimiento">Servicio Integral de Mantenimiento</option>
                </select>
              </div>

              <div>
                <label for="estimated_duration" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2">Tiempo Estimado o Cantidad *</label>
                <input type="text" id="estimated_duration" name="estimated_duration" required placeholder="Ej. 6 Meses de obra / Lote de 200 kits" class="w-full px-4 py-3.5 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-amber-500 transition" />
              </div>
            </div>

            <div>
              <label for="proposal_details" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2">Detalle de Equipos, Modelos o Especificaciones *</label>
              <textarea id="proposal_details" name="proposal_details" rows="4" required placeholder="Indica cantidades, modelos requeridos (ej. CAT 336, Scooptram 4yd, 100 respiradores 6200 con filtros 2097), turno de trabajo (día/noche), fecha de ingreso a garita..." class="w-full px-4 py-3.5 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-amber-500 transition"></textarea>
            </div>

            <div class="pt-6 border-t border-[var(--border-subtle)] flex items-center justify-between">
              <button
                type="button"
                id="btn-back-step-1"
                class="px-6 py-3 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition"
              >
                ← Volver al Paso 1
              </button>

              <button
                type="button"
                id="btn-goto-step-3"
                class="px-8 py-3.5 text-xs font-black uppercase tracking-wider text-white bg-amber-500 hover:bg-amber-600 rounded-2xl shadow-lg hover:-translate-y-0.5 transition-all flex items-center gap-2 cursor-pointer"
              >
                <span>Generar Presentación de Oferta</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </button>
            </div>
          </div>

          <!-- STEP 3: PRESENTACIÓN DE LA OFERTA -->
          <div id="step-content-3" class="step-panel hidden space-y-8 animate-in fade-in duration-300">
            <div class="border-b border-[var(--border-subtle)] pb-4">
              <span class="text-xs font-mono font-bold text-emerald-500 uppercase tracking-wider block">Paso 03 // Validación</span>
              <h2 class="text-2xl sm:text-3xl font-black text-[var(--text-primary)] font-heading mt-1">
                Dossier de Presentación y Validación de Oferta
              </h2>
              <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-1">
                Revisa el resumen técnico de tu propuesta antes de emitirla a la mesa central de operaciones.
              </p>
            </div>

            <!-- Live Proposal Card Preview -->
            <div class="p-6 sm:p-8 rounded-3xl bg-[var(--bg-main)] border border-[var(--border-strong)] space-y-6">
              <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-[var(--border-subtle)]">
                <div>
                  <span class="text-[10px] font-mono font-bold text-emerald-500 uppercase tracking-wider block">Resumen de la Propuesta</span>
                  <h3 class="text-lg font-black text-[var(--text-primary)] font-heading" id="summary-company">Consorcio Minero</h3>
                </div>
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-500 font-mono text-xs font-bold">
                  <span>SGC ISO 9001:2015</span>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
                <div class="p-3.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
                  <span class="text-[10px] text-[var(--text-muted)] font-mono uppercase block">Responsable</span>
                  <span class="font-bold text-[var(--text-primary)] text-sm" id="summary-name">Ing. Solicitante</span>
                </div>
                <div class="p-3.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
                  <span class="text-[10px] text-[var(--text-muted)] font-mono uppercase block">División</span>
                  <span class="font-bold text-[var(--text-primary)] text-sm" id="summary-division">Maquinaria Pesada</span>
                </div>
                <div class="p-3.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
                  <span class="text-[10px] text-[var(--text-muted)] font-mono uppercase block">Ubicación Obra</span>
                  <span class="font-bold text-[var(--text-primary)] text-sm truncate block" id="summary-location">Mina / Proyecto</span>
                </div>
                <div class="p-3.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
                  <span class="text-[10px] text-[var(--text-muted)] font-mono uppercase block">Modalidad</span>
                  <span class="font-bold text-[var(--text-primary)]" id="summary-modality">Con Operador</span>
                </div>
                <div class="p-3.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
                  <span class="text-[10px] text-[var(--text-muted)] font-mono uppercase block">Tiempo / Lote</span>
                  <span class="font-bold text-[var(--text-primary)]" id="summary-duration">6 Meses</span>
                </div>
                <div class="p-3.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
                  <span class="text-[10px] text-[var(--text-muted)] font-mono uppercase block">Contacto</span>
                  <span class="font-bold text-[var(--text-primary)]" id="summary-contact">987 654 321</span>
                </div>
              </div>

              <div class="p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
                <span class="text-[10px] text-[var(--text-muted)] font-mono uppercase block mb-1">Requerimiento Técnico Detallado</span>
                <p class="text-xs text-[var(--text-secondary)] leading-relaxed italic" id="summary-details">
                  Especificación de equipos...
                </p>
              </div>
            </div>

            <!-- Action Buttons for Final Presentation -->
            <div class="space-y-4 pt-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- WhatsApp Instant Submission -->
                <button
                  type="button"
                  id="btn-submit-whatsapp"
                  class="py-4 px-6 rounded-2xl bg-gradient-to-r from-[#128C7E] to-[#25D366] text-white text-xs font-black uppercase tracking-wider hover:shadow-[0_0_20px_rgba(37,211,102,0.4)] hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-3 cursor-pointer shadow-lg"
                >
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 32 32">
                    <path d="M16 2C8.268 2 2 8.268 2 16c0 2.627.72 5.087 1.973 7.193L2.054 29.5l6.495-1.892A13.918 13.918 0 0016 30c7.732 0 14-6.268 14-14S23.732 2 16 2zm0 25.568c-2.316 0-4.48-.68-6.302-1.854l-.452-.29-4.218 1.23 1.248-4.103-.314-.469A11.528 11.528 0 014.432 16c0-6.378 5.19-11.568 11.568-11.568 6.378 0 11.568 5.19 11.568 11.568 0 6.378-5.19 11.568-11.568 11.568zm6.544-8.683c-.358-.18-2.12-.1047-2.449-1.166-.329-.12-.569-.18-.809.18-.239.359-.927 1.166-1.136 1.405-.21.24-.419.27-.778.09-.359-.18-1.517-.56-2.89-1.785-1.069-.953-1.79-2.13-2-.249-.21-.359-.022-.553.158-.732.162-.161.359-.419.539-.628.18-.21.24-.359.359-.599.12-.24.06-.449-.03-.628-.09-.18-.809-1.95-1.108-2.67-.291-.7-.588-.606-.809-.617l-.689-.012c-.24 0-.628.09-.957.449-.329.359-1.257 1.228-1.257 2.994 0 1.766 1.287 3.473 1.467 3.713.18.24 2.533 3.868 6.136 5.424.857.37 1.526.591 2.048.757.86.274 1.644.235 2.263.143.69-.103 2.12-.867 2.419-1.706.299-.838.299-1.557.21-1.706-.09-.15-.33-.24-.689-.419z"/>
                  </svg>
                  <span>Emitir Oferta vía WhatsApp 24/7</span>
                </button>

                <!-- Corporate Central Submission -->
                <button
                  type="submit"
                  class="py-4 px-6 rounded-2xl bg-[#DC2626] hover:bg-[#B91C1C] text-white text-xs font-black uppercase tracking-wider hover:shadow-lg shadow-red-950/40 hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-3 cursor-pointer"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                  <span>Enviar a Mesa Central de Partes</span>
                </button>
              </div>

              <div id="proposal-success-msg" class="hidden p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs text-center font-bold">
                🎉 ¡Propuesta técnica registrada con éxito! Redirigiendo a nuestro canal de operaciones para atención prioritaria...
              </div>

              <div class="flex justify-start pt-2">
                <button
                  type="button"
                  id="btn-back-step-2"
                  class="text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition"
                >
                  ← Modificar Propuesta (Paso 2)
                </button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';

  let currentStep = 1;
  const whatsappNumber = "51963895085";

  const tabBtns = document.querySelectorAll('.step-tab');
  const stepPanels = document.querySelectorAll('.step-panel');
  const form = document.getElementById('proposal-wizard-form') as HTMLFormElement;

  document.getElementById('btn-goto-step-2')?.addEventListener('click', () => {
    const name = (document.getElementById('client_name') as HTMLInputElement).value;
    const company = (document.getElementById('company_ruc') as HTMLInputElement).value;
    const phone = (document.getElementById('client_phone') as HTMLInputElement).value;
    const email = (document.getElementById('client_email') as HTMLInputElement).value;
    const location = (document.getElementById('project_location') as HTMLInputElement).value;

    if (!name || !company || !phone || !email || !location) {
      alert('Por favor completa todos los campos del Paso 1 para continuar.');
      return;
    }
    setStep(2);
  });

  document.getElementById('btn-goto-step-3')?.addEventListener('click', () => {
    const duration = (document.getElementById('estimated_duration') as HTMLInputElement).value;
    const details = (document.getElementById('proposal_details') as HTMLTextAreaElement).value;

    if (!duration || !details) {
      alert('Por favor completa el tiempo estimado y el detalle del requerimiento.');
      return;
    }
    updateSummary();
    setStep(3);
  });

  document.getElementById('btn-back-step-1')?.addEventListener('click', () => setStep(1));
  document.getElementById('btn-back-step-2')?.addEventListener('click', () => setStep(2));

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetStep = parseInt(btn.getAttribute('data-step') || '1');
      if (targetStep < currentStep || validateUpTo(targetStep)) {
        if (targetStep === 3) updateSummary();
        setStep(targetStep);
      }
    });
  });

  function validateUpTo(target: number) {
    if (target >= 2) {
      const name = (document.getElementById('client_name') as HTMLInputElement).value;
      const company = (document.getElementById('company_ruc') as HTMLInputElement).value;
      if (!name || !company) return false;
    }
    if (target === 3) {
      const details = (document.getElementById('proposal_details') as HTMLTextAreaElement).value;
      if (!details) return false;
    }
    return true;
  }

  const divisionLabels = document.querySelectorAll('.division-radio-label');
  divisionLabels.forEach(label => {
    label.addEventListener('click', () => {
      divisionLabels.forEach(l => {
        l.classList.remove('border-2', 'border-red-500', 'border-amber-500', 'border-blue-500', 'bg-red-500/10', 'bg-amber-500/10', 'bg-blue-500/10');
        l.classList.add('border', 'border-[var(--border-strong)]', 'bg-[var(--bg-main)]');
        const dot = l.querySelector('.radio-dot');
        if (dot) {
          dot.textContent = '';
          dot.className = 'w-4 h-4 rounded-full border-2 border-slate-400 flex items-center justify-center text-white text-[9px] radio-dot';
        }
      });
      label.classList.remove('border', 'border-[var(--border-strong)]', 'bg-[var(--bg-main)]');
      label.classList.add('border-2', 'border-red-500', 'bg-red-500/10');
      const radio = label.querySelector('input[type="radio"]') as HTMLInputElement;
      if (radio) radio.checked = true;
      const activeDot = label.querySelector('.radio-dot');
      if (activeDot) {
        activeDot.textContent = '✓';
        activeDot.className = 'w-4 h-4 rounded-full border-2 border-[#DC2626] bg-[#DC2626] flex items-center justify-center text-white text-[9px] radio-dot';
      }
    });
  });

  function updateSummary() {
    const name = (document.getElementById('client_name') as HTMLInputElement).value;
    const company = (document.getElementById('company_ruc') as HTMLInputElement).value;
    const phone = (document.getElementById('client_phone') as HTMLInputElement).value;
    const location = (document.getElementById('project_location') as HTMLInputElement).value;
    const division = (document.querySelector('input[name="proposal_division"]:checked') as HTMLInputElement)?.value || 'Maquinaria';
    const modality = (document.getElementById('operation_modality') as HTMLSelectElement).value;
    const duration = (document.getElementById('estimated_duration') as HTMLInputElement).value;
    const details = (document.getElementById('proposal_details') as HTMLTextAreaElement).value;

    (document.getElementById('summary-company') as HTMLElement).textContent = company || 'Empresa no especificada';
    (document.getElementById('summary-name') as HTMLElement).textContent = name || '-';
    (document.getElementById('summary-division') as HTMLElement).textContent = division;
    (document.getElementById('summary-location') as HTMLElement).textContent = location || '-';
    (document.getElementById('summary-modality') as HTMLElement).textContent = modality;
    (document.getElementById('summary-duration') as HTMLElement).textContent = duration || '-';
    (document.getElementById('summary-contact') as HTMLElement).textContent = phone || '-';
    (document.getElementById('summary-details') as HTMLElement).textContent = `"${details}"` || '-';
  }

  function setStep(step: number) {
    currentStep = step;

    tabBtns.forEach(btn => {
      const s = parseInt(btn.getAttribute('data-step') || '1');
      if (s === currentStep) {
        btn.className = 'step-tab flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl sm:rounded-full text-xs font-bold transition-all duration-300 cursor-pointer bg-blue-600 text-white shadow-md scale-102';
      } else if (s < currentStep) {
        btn.className = 'step-tab flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl sm:rounded-full text-xs font-bold transition-all duration-300 cursor-pointer text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20';
      } else {
        btn.className = 'step-tab flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl sm:rounded-full text-xs font-bold transition-all duration-300 cursor-pointer text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white';
      }
    });

    stepPanels.forEach(panel => {
      panel.classList.add('hidden');
    });

    const activePanel = document.getElementById(`step-content-${step}`);
    if (activePanel) {
      activePanel.classList.remove('hidden');
      gsap.fromTo(activePanel, 
        { opacity: 0, y: 15 },
        { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' }
      );
    }
  }

  function generateWhatsAppText() {
    const name = (document.getElementById('client_name') as HTMLInputElement).value;
    const company = (document.getElementById('company_ruc') as HTMLInputElement).value;
    const phone = (document.getElementById('client_phone') as HTMLInputElement).value;
    const email = (document.getElementById('client_email') as HTMLInputElement).value;
    const location = (document.getElementById('project_location') as HTMLInputElement).value;
    const division = (document.querySelector('input[name="proposal_division"]:checked') as HTMLInputElement)?.value || 'Maquinaria';
    const modality = (document.getElementById('operation_modality') as HTMLSelectElement).value;
    const duration = (document.getElementById('estimated_duration') as HTMLInputElement).value;
    const details = (document.getElementById('proposal_details') as HTMLTextAreaElement).value;

    return `*📋 PROPUESTA TÉCNICA - SERVITOTALES S.A.C.*\n` +
      `----------------------------------------\n` +
      `*1. INFORMACIÓN DEL CLIENTE:*\n` +
      `• *Empresa / RUC:* ${company}\n` +
      `• *Contacto:* ${name}\n` +
      `• *Teléfono:* ${phone}\n` +
      `• *Email:* ${email}\n` +
      `• *Ubicación Obra:* ${location}\n\n` +
      `*2. DETALLE DE LA PROPUESTA:*\n` +
      `• *División:* ${division}\n` +
      `• *Modalidad:* ${modality}\n` +
      `• *Tiempo / Lote:* ${duration}\n` +
      `• *Requerimiento:* ${details}\n` +
      `----------------------------------------\n` +
      `_Enviado desde la Mesa de Propuestas Oficial de servitotales.com_`;
  }

  document.getElementById('btn-submit-whatsapp')?.addEventListener('click', () => {
    const text = generateWhatsAppText();
    const successMsg = document.getElementById('proposal-success-msg');
    if (successMsg) successMsg.classList.remove('hidden');
    setTimeout(() => {
      window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`, '_blank');
    }, 1000);
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = generateWhatsAppText();
    const successMsg = document.getElementById('proposal-success-msg');
    if (successMsg) successMsg.classList.remove('hidden');
    setTimeout(() => {
      window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`, '_blank');
    }, 1200);
  });
</script>
